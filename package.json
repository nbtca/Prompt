{
  "name": "@nbtca/prompt",
  "version": "1.5.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "nbtca": "dist/index.js",
    "nbtca-welcome": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc",
    "postbuild": "node scripts/copy-assets.js",
    "clean": "node scripts/clean.js",
    "prebuild": "npm run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "vitest run && npm run test:cli",
    "test:cli": "npm run build && bash scripts/test-cli.sh",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:package && npm audit --audit-level=moderate",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "cli",
    "terminal",
    "welcome",
    "nbtca",
    "community",
    "calendar",
    "tui",
    "interactive"
  ],
  "dependencies": {
    "@nbtca/docs": "^0.3.0",
    "@nbtca/nbtcal": "^0.4.0",
    "chalk": "^5.6.2",
    "cheerio": "1.0.0",
    "fetch-cookie": "^3.2.0",
    "gradient-string": "^3.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.0.0",
    "open": "^11.0.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "20.12.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "author": "m1ngsama <contact@m1ng.space>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbtca/Prompt.git"
  },
  "bugs": {
    "url": "https://github.com/nbtca/Prompt/issues"
  },
  "homepage": "https://github.com/nbtca/Prompt#readme",
  "description": "Terminal information system for the NBTCA community"
}
